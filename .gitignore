.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-preload-cache/
.pub/

# Archivos generados por código (opcional: comenta si prefieres versionarlos)
# *.g.dart
# *.freezed.dart

# Símbolos y ofuscación de Flutter
app.*.symbols
app.*.map.json

# ==========================================================
# 6. EXCEPCIONES IMPORTANTES (No ignorar)
# ==========================================================
# Asegura que el wrapper de Gradle sí se suba (necesario para compilar Android/RN/Flutter)
!gradle-wrapper.jar